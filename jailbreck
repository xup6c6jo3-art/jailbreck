RunService:BindToRenderStep("JB_AntiRecoil", Enum.RenderPriority.Camera.Value + 2, function()
    if not C.NoRecoil then return end
    if tick() > camLockUntil then return end
    if not camSavedCFrame then return end
    if tick() - lastMouseMove < 0.05 then
        camSavedCFrame = Camera.CFrame
        return
    end
    Camera.CFrame = Camera.CFrame:Lerp(camSavedCFrame, 0.9)
