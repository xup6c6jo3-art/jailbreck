local lastTrigger = 0
RunService.Heartbeat:Connect(function()
    if not C.TriggerOn then return end
    if not isKeyDown(C.TriggerKey) then return end
    if tick() - lastTrigger < C.TriggerDelay then return end

    local origin = Camera.CFrame.Position
    local dir = Camera.CFrame.LookVector * 800
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = {LP.Character}
    local hit = Workspace:Raycast(origin, dir, rp)
    if hit and hit.Instance then
        local model = hit.Instance:FindFirstAncestorOfClass("Model")
        if model then
            local plr = Players:GetPlayerFromCharacter(model)
            if plr and plr ~= LP then
                if not (C.AimTeamChk and plr.Team and plr.Team == LP.Team) and hasGunEquipped() then
                    lastTrigger = tick()
                    triggerCamLock()
                    task.spawn(fireOnce)
                end
            end
        end
    end
end)

