local espData = {}

local function getESPColor(h, mh)
    if C.ESPColorMode == 2 then return Color3.fromRGB(0, 220, 255) end
    if C.ESPColorMode == 3 then return Color3.fromRGB(255, 255, 255) end
    if C.ESPColorMode == 4 then return Color3.fromRGB(255, 60, 255) end
    local r = h / math.max(mh, 1)
    if r < 0.35 then return Color3.fromRGB(255, 30, 60) end
    if r < 0.7 then return Color3.fromRGB(255, 200, 0) end
    return Color3.fromRGB(0, 255, 100)
end

local function createESP(player)
    if player == LP or espData[player] or not hasDrawing then return end
    local box = Drawing.new("Square")
    box.Visible = false; box.Thickness = 2; box.Filled = false
    local ol = Drawing.new("Square")
    ol.Visible = false; ol.Thickness = 1; ol.Filled = false; ol.Color = Color3.fromRGB(0, 0, 0)
    local nameTag = Drawing.new("Text")
    nameTag.Visible = false; nameTag.Center = true; nameTag.Outline = true
    nameTag.Size = 16; nameTag.Color = Color3.fromRGB(255, 255, 255); nameTag.Font = 2
    local distTag = Drawing.new("Text")
    distTag.Visible = false; distTag.Center = true; distTag.Outline = true
    distTag.Size = 14; distTag.Color = Color3.fromRGB(255, 220, 0); distTag.Font = 2
    local hpBG = Drawing.new("Square")
    hpBG.Visible = false; hpBG.Filled = true; hpBG.Color = Color3.fromRGB(20, 20, 20)
    local hpBar = Drawing.new("Square")
    hpBar.Visible = false; hpBar.Filled = true

    local conn = RunService.RenderStepped:Connect(function()
        local function hide()
            box.Visible = false; ol.Visible = false; nameTag.Visible = false
            distTag.Visible = false; hpBG.Visible = false; hpBar.Visible = false
        end
        if not player.Parent then
            conn:Disconnect()
            box:Remove(); ol:Remove(); nameTag:Remove()
            distTag:Remove(); hpBG:Remove(); hpBar:Remove()
            espData[player] = nil
            return
        end
        if not C.ESPOn then hide() return end
        local char = player.Character
        if not char then hide() return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then hide() return end
        if C.ESPTeamChk and player.Team and player.Team == LP.Team then hide() return end

        local sp, on = Camera:WorldToViewportPoint(hrp.Position)
        if not on then hide() return end

        local scale = 1 / (sp.Z * math.tan(math.rad(Camera.FieldOfView * 0.5))) * 1000
        local w, h = 4.2 * scale, 6.2 * scale
        local pos = Vector2.new(sp.X - w / 2, sp.Y - h / 2)
        local col = getESPColor(hum.Health, hum.MaxHealth)

        box.Size = Vector2.new(w, h); box.Position = pos; box.Color = col
        ol.Size = Vector2.new(w + 3, h + 3); ol.Position = Vector2.new(pos.X - 1.5, pos.Y - 1.5)
        box.Visible = true; ol.Visible = true

        if C.ESPName then
            nameTag.Text = player.Name
            nameTag.Position = Vector2.new(sp.X, pos.Y - 20)
            nameTag.Color = col; nameTag.Visible = true
        else nameTag.Visible = false end

        if C.ESPDist then
            local d = math.floor((hrp.Position - Camera.CFrame.Position).Magnitude)
            distTag.Text = d .. " studs"
            distTag.Position = Vector2.new(sp.X, pos.Y + h + 4)
            distTag.Visible = true
        else distTag.Visible = false end

        if C.ESPHP then
            local r = hum.Health / math.max(hum.MaxHealth, 1)
            local bx = pos.X + w + 4
            hpBG.Size = Vector2.new(4, h); hpBG.Position = Vector2.new(bx, pos.Y)
            hpBar.Size = Vector2.new(4, h * r)
            hpBar.Position = Vector2.new(bx, pos.Y + h * (1 - r))
            hpBar.Color = col
            hpBG.Visible = true; hpBar.Visible = true
        else hpBG.Visible = false; hpBar.Visible = false end
    end)
    espData[player] = {conn = conn}
end

