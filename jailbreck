-- Recoil cleanup
local lastRecoilScan = 0
RunService.Heartbeat:Connect(function()
    if not C.NoRecoil then return end
    if tick() - lastRecoilScan < 0.4 then return end
    lastRecoilScan = tick()

    local char = LP.Character
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")

    if tool then
        for _, v in ipairs(tool:GetDescendants()) do
            if v:IsA("NumberValue") then
                local n = v.Name:lower()
                if not n:find("ammo") and not n:find("cool") and not n:find("rate")
                and not n:find("damage") and not n:find("reload") and not n:find("clip") then
                    if n:find("recoil") or n:find("kick") or n:find("spread")
                    or n:find("shake") or n:find("cam") then
                        pcall(function() v.Value = 0 end)
                    end
                end
            end
        end
    end

    for _, v in ipairs(char:GetDescendants()) do
        if v:IsA("NumberValue") then
            local n = v.Name:lower()
            if (n:find("recoil") or n:find("kickback") or n:find("camkick") or n:find("camshake"))
            and not n:find("ammo") and not n:find("cooldown") then
                pcall(function() v.Value = 0 end)
            end
        end
    end
end)

-- ==================== AIMBOT MAIN LOOP ====================
RunService:BindToRenderStep("JB_Aim", Enum.RenderPriority.Camera.Value + 1, function(dt)
    -- FOV circle
    if fovCircle then
        if C.AimShowFOV and C.AimEnabled then
            local m = UserInputService:GetMouseLocation()
            fovCircle.Position = Vector2.new(m.X, m.Y)
            fovCircle.Radius = C.AimFOV
            fovCircle.Visible = true
        else
            fovCircle.Visible = false
        end
    end

    if currentTargetPart and not isCurrentTargetValid() then
        currentTargetPart = nil
        currentTargetPlayer = nil
    end

    if not C.AimEnabled then return end
    if not isKeyDown(C.AimKey) then return end
    if not currentTargetPart then return end

    local camPos = Camera.CFrame.Position
    local desired = CFrame.new(camPos, currentTargetPart.Position)
    local speed = (1 - C.AimSmooth) * 60
    local alpha = math.clamp(1 - math.exp(-speed * dt), 0.02, 1)
    Camera.CFrame = Camera.CFrame:Lerp(desired, alpha)

    if C.NoRecoil and tick() < camLockUntil then
        camSavedCFrame = Camera.CFrame
    end

    if C.AimAutoFire then
        local now = tick()
        if now - lastFireTime >= C.AimFireRate and hasGunEquipped() then
            local _, onScreen = Camera:WorldToViewportPoint(currentTargetPart.Position)
            if onScreen then
                lastFireTime = now
                triggerCamLock()
