end

local function resetChar()
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    destroyFly(hrp)
    destroyBhop(hrp)
    if hum then
        pcall(function()
            hum.PlatformStand = false
            hum.Sit = false
            hum.WalkSpeed = 16
            hum.JumpPower = 50
            hum.AutoRotate = true
        end)
    end
    if hrp then
        pcall(function()
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end)
    end
end

local function createFly(hrp, hum)
    destroyFly(hrp)
    destroyBhop(hrp)
    hum.PlatformStand = true
    local bv = Instance.new("BodyVelocity")
    bv.Name = "JB_Fly_BV"
    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bv.Velocity = Vector3.new(0, 0, 0)
    bv.P = 1250
    bv.Parent = hrp
    local bg = Instance.new("BodyGyro")
    bg.Name = "JB_Fly_BG"
    bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    bg.P = 10000
    bg.D = 200
    bg.CFrame = hrp.CFrame
    bg.Parent = hrp
end

local function startMoveLoop()
    if moveConn then moveConn:Disconnect() end
    moveConn = RunService.RenderStepped:Connect(function(dt)
        local char = LP.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return end

        if C.SpinEnabled then
            hum.AutoRotate = false
            currentAngle = (currentAngle + C.SpinSpeed) % 360
        else
            currentAngle = 0
        end
        local spunCF = CFrame.new(hrp.Position) * CFrame.Angles(0, math.rad(currentAngle), 0)

        local v = hrp.AssemblyLinearVelocity
        if C.NoFall and not C.FlyEnabled and v.Y < -50 then
            hrp.AssemblyLinearVelocity = Vector3.new(v.X, -10, v.Z)
        end
        if C.AntiFling and not C.FlyEnabled and v.Magnitude > 400 then
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end

        if C.FlyEnabled then
            destroyBhop(hrp)
            local bv = hrp:FindFirstChild("JB_Fly_BV")
            local bg = hrp:FindFirstChild("JB_Fly_BG")
            if not bv or not bg then createFly(hrp, hum); return end
            hum.WalkSpeed = 0
            hum.PlatformStand = true

            local camCF = Camera.CFrame
            local dir = Vector3.new(0, 0, 0)
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += camCF.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= camCF.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= camCF.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += camCF.RightVector end

            local vert = 0
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vert += 1 end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
            or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then vert -= 1 end

            local finalDir = Vector3.new(0, 0, 0)
            if dir.Magnitude > 0 then finalDir += dir.Unit * C.FlySpeed end
            finalDir += Vector3.new(0, vert * C.FlyVertical, 0)
            if C.AimFollow and currentTargetPart then
                finalDir += (currentTargetPart.Position - hrp.Position).Unit * C.FlySpeed
            end
            bv.Velocity = finalDir
            bg.CFrame = spunCF

        elseif C.BhopEnabled then
            destroyFly(hrp)
            if hum.PlatformStand then hum.PlatformStand = false end
            hum.WalkSpeed = 0
            local bv = hrp:FindFirstChild("JB_Bhop_BV")
            if not bv then
                bv = Instance.new("BodyVelocity")
                bv.Name = "JB_Bhop_BV"
                bv.MaxForce = Vector3.new(9e9, 0, 9e9)
                bv.P = 1250
                bv.Parent = hrp
            end
            local md = hum.MoveDirection
            if md.Magnitude > 0 then
                bv.Velocity = Vector3.new(md.X * C.BhopSpeed, 0, md.Z * C.BhopSpeed)
            else
                bv.Velocity = Vector3.new(0, 0, 0)
            end
            if C.SpinEnabled then hrp.CFrame = spunCF end

        else
            destroyFly(hrp)
            destroyBhop(hrp)
            if hum.PlatformStand then hum.PlatformStand = false end
            hum.WalkSpeed = 16
            if C.SpinEnabled then hrp.CFrame = spunCF end
        end
    end)
end

task.spawn(startMoveLoop)

