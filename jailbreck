-- ==================== SERVER HOP ====================
local function serverHop()
    if not hasRequest then notify("HOP", "request unavailable"); return end
    notify("HOP", "Searching server...")
    local ok, res = pcall(function()
        return request({
            Url = "https://games.roblox.com/v1/games/" .. game.PlaceId ..
                  "/servers/Public?sortOrder=Desc&limit=100",
            Method = "GET"
        })
    end)
    if not ok or not res or not res.Body then notify("HOP", "API error"); return end
    local dOK, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
    if not dOK or not data or not data.data then return end
    table.sort(data.data, function(a, b) return (a.playing or 0) > (b.playing or 0) end)
    for _, s in ipairs(data.data) do
        if s.id ~= game.JobId and (s.playing or 0) < (s.maxPlayers or 0) then
            notify("HOP", "-> " .. s.playing .. "/" .. s.maxPlayers)
            task.wait(0.4)
            pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LP) end)
            return
        end
    end
end
