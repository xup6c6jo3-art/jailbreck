local function keyToInput(k)
    if k == "RightMouse" then return Enum.UserInputType.MouseButton2 end
    if k == "LeftAlt"    then return Enum.KeyCode.LeftAlt end
    if k == "E"          then return Enum.KeyCode.E end
    if k == "Q"          then return Enum.KeyCode.Q end
    if k == "C"          then return Enum.KeyCode.C end
    return Enum.UserInputType.MouseButton2
end

local function isKeyDown(k)
    local item = keyToInput(k)
    if typeof(item) == "EnumItem" and item.EnumType == Enum.KeyCode then
        return UserInputService:IsKeyDown(item)
    else
        return UserInputService:IsMouseButtonPressed(item)
    end
end

-- MAIN FUNCTION: check if player is seated in a vehicle
-- Works by TWO signs: Humanoid.Sit OR SeatPart presence
local function isSeated(char)
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    if hum.Sit == true then return true end
    if hum.SeatPart ~= nil then return true end
    -- Fallback: HRP welded to something outside of character
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp and hrp.Parent ~= char then return true end
    return false
end

-- Select part for aim (in vehicle use HRP, since Head is hidden inside)
local function getTargetPart(char)
    if isSeated(char) then
        return char:FindFirstChild("HumanoidRootPart")
    end
    if C.AimTarget == "Head" then
        return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    elseif C.AimTarget == "UpperTorso" then
        return char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart")
    else
        return char:FindFirstChild("HumanoidRootPart")
    end
end

-- KEY FIX: if target is seated - always considered visible
-- (inside car/helicopter it is not visible behind the body, but it is there)
local function isVisible(targetPart, targetChar)
    if not C.AimVisChk then return true end
    if isSeated(targetChar) then return true end

    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = {LP.Character}
    local hit = Workspace:Raycast(Camera.CFrame.Position,
        targetPart.Position - Camera.CFrame.Position, rp)
    if not hit then return true end
    if hit.Instance:IsDescendantOf(targetChar) then return true end

    -- Additionally: if hit the vehicle where target is seated - consider visible
    local hitModel = hit.Instance:FindFirstAncestorOfClass("Model")
    if hitModel then
        local hum = targetChar:FindFirstChildOfClass("Humanoid")
        if hum and hum.SeatPart and hum.SeatPart:IsDescendantOf(hitModel) then
            return true
        end
    end
    return false
end

-- ==================== AIM CORE ====================
local currentTargetPart = nil
local currentTargetPlayer = nil

local function updateAimTarget()
    if not C.AimEnabled then
        currentTargetPart = nil
        currentTargetPlayer = nil
        return
    end
    local char = LP.Character
    local myHum = char and char:FindFirstChildOfClass("Humanoid")
    if not myHum or myHum.Health <= 0 then
        currentTargetPart = nil
        currentTargetPlayer = nil
        return
    end

    local mouseLoc = UserInputService:GetMouseLocation()
    local camPos = Camera.CFrame.Position
    local best, bestScore, bestPart, bestPlr = nil, math.huge, nil, nil
    local nearestDist = math.huge
    local nearestPart, nearestPlr = nil, nil

    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        if C.AimTeamChk and p.Team and p.Team == LP.Team then continue end
        local pc = p.Character
        if not pc then continue end
        local phrp = pc:FindFirstChild("HumanoidRootPart")
        local phum = pc:FindFirstChildOfClass("Humanoid")
        if not phrp or not phum or phum.Health <= 0 then continue end

        local dist3D = (phrp.Position - camPos).Magnitude
        if dist3D > C.AimMaxDist then continue end

        local tp = getTargetPart(pc)
        if not tp then continue end

        local sp, on = Camera:WorldToViewportPoint(tp.Position)
        if not on then continue end
        if not isVisible(tp, pc) then continue end

        local d2D = (Vector2.new(sp.X, sp.Y) - Vector2.new(mouseLoc.X, mouseLoc.Y)).Magnitude
        if d2D > C.AimFOV then continue end

        if C.AimPriority == "Crosshair" then
            if d2D < bestScore then
                bestScore = d2D
                bestPart = tp; bestPlr = p
            end
        else
            if dist3D < nearestDist then
                nearestDist = dist3D
                nearestPart = tp; nearestPlr = p
            end
        end
    end

    if C.AimPriority == "Crosshair" then
        currentTargetPart = bestPart
        currentTargetPlayer = bestPlr
    else
        currentTargetPart = nearestPart
        currentTargetPlayer = nearestPlr
    end
end

local function isCurrentTargetValid()
    if not currentTargetPart or not currentTargetPlayer then return false end
    if not currentTargetPart.Parent then return false end
    local pchar = currentTargetPlayer.Character
    if not pchar or not currentTargetPart:IsDescendantOf(pchar) then return false end
    local hum = pchar:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    return true
end

