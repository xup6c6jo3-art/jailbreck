local function makeSlider(text, min, max, default, isInt, callback)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, -5, 0, 42)
    f.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
    f.BorderSizePixel = 0
    f.LayoutOrder = nextOrder()
    f.Parent = content
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 6)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -60, 0, 16)
    lbl.Position = UDim2.new(0, 10, 0, 3)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = Color3.fromRGB(210, 210, 220)
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 12
    lbl.Parent = f

    local vLbl = Instance.new("TextLabel")
    vLbl.Size = UDim2.new(0, 55, 0, 16)
    vLbl.Position = UDim2.new(1, -60, 0, 3)
    vLbl.BackgroundTransparency = 1
    vLbl.Text = isInt and tostring(math.floor(default)) or string.format("%.2f", default)
    vLbl.TextColor3 = Color3.fromRGB(150, 130, 255)
    vLbl.TextXAlignment = Enum.TextXAlignment.Right
    vLbl.Font = Enum.Font.GothamBold
    vLbl.TextSize = 12
    vLbl.Parent = f

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, -20, 0, 6)
    bar.Position = UDim2.new(0, 10, 0, 28)
    bar.BackgroundColor3 = Color3.fromRGB(50, 50, 62)
    bar.BorderSizePixel = 0
    bar.Parent = f
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(120, 90, 255)
    fill.BorderSizePixel = 0
    fill.Parent = bar
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local dragging = false
    local function setFromX(x)
        local rel = math.clamp(x - bar.AbsolutePosition.X, 0, bar.AbsoluteSize.X)
        local r = rel / bar.AbsoluteSize.X
        local v = min + (max - min) * r
        if isInt then v = math.floor(v + 0.5) end
        fill.Size = UDim2.new(r, 0, 1, 0)
        vLbl.Text = isInt and tostring(v) or string.format("%.2f", v)
        callback(v)
    end
    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setFromX(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            setFromX(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

